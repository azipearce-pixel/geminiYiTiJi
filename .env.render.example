# Downstream web-console password; your SillyTavern API key can use this value.
AISTUDIO_WEB_PASSWORD=replace-with-a-long-random-password

# Option A: Render Secret Files (recommended)
AISTUDIO_COOKIE_FILE=/etc/secrets/aistudio_cookie.json
GOOGLE_API_KEYS_FILE=/etc/secrets/google_api_keys.txt

# Option B: environment variables instead of Secret Files
# AISTUDIO_COOKIE='paste Cookie-Editor JSON or Cookie header here'
# GOOGLE_API_KEYS='AIza...one,AIza...two'
# GOOGLE_API_KEY=AIza...single-key

# Optional Cookie account metadata
AISTUDIO_COOKIE_TIER=Free
AISTUDIO_COOKIE_AUTH_USER=0
AISTUDIO_COOKIE_NAME=Render Secret Cookie
